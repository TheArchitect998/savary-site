// ===== FILE: src/pages/index.astro =====
---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const links = {
  github: 'https://github.com/TheArchitect998',
  // codeberg: 'https://codeberg.org/DEIN-USER', TODO
  linkedin: 'https://www.linkedin.com/in/pius-jj-savary',
  email: 'mailto:kontakt@savary.one',
  storePdf: 'https://apps.microsoft.com/detail/9p628vwsxmjt?ocid=webpdpshare',
  websiteNodeSentinel: 'https://nodesentinel.de',
  repoNodeSentinel: 'https://github.com/TheArchitect998/NodeSentinel',
  dockerHub: 'https://hub.docker.com/u/thearchitect998',
};
const projekte = [
  {
    name: 'NodeSentinel',
    status: 'Aktiv',
    statusClass: 'done',
    logo: '/images/nodesentinel-logo.svg',
    logoAlt: 'NodeSentinel',
    beschreibung:
      'NodeSentinel ist ein selbst gehostetes, vollständig in Go geschriebenes Monitoring-Dashboard für Linux-Hosts und Homelabs. Es zeigt CPU, RAM, Temperaturen, Docker-Container, UFW- und Fail2Ban-Status mit 30 Tagen Verlauf. Dashboard und Agent laufen ohne Python-Laufzeit; Daten werden weiterhin lokal in SQLite gespeichert.',
    releases: [
      {
        version: 'v2.4.3',
        titel: 'Dashboard-Design',
        punkte: [
          'Das Dashboard und die Anmeldeseite zeigen das neue NodeSentinel-Logo.',
          'Browser-Favicons und Symbole für Desktop- und iPhone-Homebildschirm-Verknüpfungen ergänzt.',
          'Die Symboldateien sind im Docker-Image enthalten.',
        ],
        hinweis: 'Bei nativen Installationen das Dashboard-Binary zusammen mit frontend/index.html und frontend/icons/ aktualisieren. Bestehende Verknüpfungen müssen möglicherweise neu erstellt werden.',
      },
      {
        version: 'v2.4.2',
        titel: 'Fehlerbehebung',
        punkte: [
          'Docker-Container-Benachrichtigungen verarbeiten Nanosekunden-Zeitstempel jetzt ohne Präzisionsverlust.',
          'Start-/Stopp-Ereignisse werden damit wieder korrekt an konfigurierte Anbieter versendet.',
          'Regressionstest für reale Docker-Event-Zeitstempel ergänzt.',
        ],
        hinweis: '',
      },
      {
        version: 'v2.4.1',
        titel: '',
        punkte: [
          'WebSocket-Push: Agenten verbinden sich ausgehend und verschlüsselt mit dem Dashboard und senden regelmäßig Messwerte.',
          'Weniger Berechtigungen: Docker-Socket, Host-Dateisystem und Journal sind standardmäßig nicht eingebunden. Zusätzliche Datenquellen lassen sich bei Bedarf aktivieren.',
          'Gehärteter Dienst: Das systemd-Beispiel nutzt einen separaten Benutzer und zusätzliche Schutzmaßnahmen.',
          'Wiederverbindung: Agenten verbinden sich nach einem Ausfall automatisch erneut. Ereignisse werden nach Möglichkeit aus lokalen Quellen nachgeholt.',
        ],
        hinweis: '',
      },
    ],
    bild: '/images/dashboard.png',
    bildAlt: 'Screenshot von NodeSentinel mit Systemmetriken und Containerstatus',
    bildHinweis: 'Screenshot des Dashboards mit fiktiven Beispieldaten.',
    stack: ['Go', 'SQLite', 'Docker', 'HTML', 'JavaScript', 'Self-Hosting'],
    href: links.websiteNodeSentinel,
    linkLabel: 'NodeSentinel-Dokumentation',
    secondaryHref: links.repoNodeSentinel,
    secondaryLinkLabel: 'GitHub-Repository',
    tertiaryHref: links.dockerHub,
    tertiaryLinkLabel: 'Docker Hub',
  },
  {
    name: 'PDF-Migrator',
    status: 'Im Microsoft Store',
    statusClass: 'done',
    beschreibung:
      'Der PDF-Migrator führt getrennt gescannte Vorder- und Rückseiten zu einem PDF zusammen. Dazu wählst du eine Datei mit den ungeraden und eine mit den geraden Seiten; für die geraden Seiten lässt sich die Reihenfolge umkehren. Eine Vorschau zeigt die resultierende Seitenfolge. Die Verarbeitung erfolgt lokal auf deinem Windows-Gerät, ohne Dateien hochzuladen.',
    bild: '/images/pdf-migrator.png',
    bildAlt: 'Screenshot des PDF-Migrators',
    bildHinweis: null,
    stack: ['Windows App', 'Python'],
    href: links.storePdf,
    linkLabel: 'Microsoft Store',
    badge: 'https://get.microsoft.com/images/de%20light.svg',
  },
  {
    name: 'Pflegedokumentationssystem',
    status: 'In Entwicklung',
    statusClass: 'wip',
    beschreibung:
      'Eine in Entwicklung befindliche webbasierte Pflegedokumentation für den Pflegealltag. Die selbst gehostete Anwendung unterstützt unter anderem die Erfassung von Pflegeeinträgen, Vitalwerten und Medikamentenbeständen und verbindet meine Erfahrung im Gesundheitswesen mit Softwareentwicklung.',
    bild: '/images/pflegedoku.png',
    bildAlt: 'Screenshot der Pflegedokumentation mit Vitalwerten einer Demo-Person',
    bildHinweis: 'Screenshot der Anwendung mit fiktiven Beispieldaten.',
    stack: ['Python', 'Flask', 'SQLite', 'Docker', 'Self-Hosting'],
  },
];
---
<Base title="Pius Savary – Self-Hoster & Hobby-Entwickler">
  <Header />
  <main class="container">
    <section class="hero">
      <img class="portrait" src="/images/Pius.jpg" alt="Porträt von Pius Savary" width="1368" height="2000" />
      <div>
        <h1>Pius Savary</h1>
        <p class="subtitle"><strong>Self-Hoster &amp; Hobby-Entwickler</strong></p>
        <p>
          Ich komme aus dem Gesundheitswesen und beschäftige mich seit einiger
          Zeit intensiv mit IT – selbstständig und mit viel Neugier. In meinem
          Homelab hoste und betreibe ich eigene Dienste und entwickle Software,
          die genau dort ansetzt, wo ich aus dem Berufsalltag Lücken kenne.
        </p>
      </div>
    </section>
    <section id="projekte">
      <h2>Projekte</h2>
      {projekte.map((p) => (
        <article class="card">
          <div class="project-heading">
            {p.logo
              ? <h3><img class="project-logo" src={p.logo} alt={p.logoAlt} width="760" height="180" /></h3>
              : <h3>{p.name}</h3>}
            <span class={`status ${p.statusClass}`}>{p.status}</span>
          </div>
          <p>{p.beschreibung}</p>
          {p.releases && (
            <>
              <h4>Die letzten Releases</h4>
              <div class="releases">
                {p.releases.map((release) => (
                  <section class="release">
                    <h5>{release.version}{release.titel && ` – ${release.titel}`}</h5>
                    <ul>
                      {release.punkte.map((punkt) => <li>{punkt}</li>)}
                    </ul>
                    {release.hinweis && <p class="release-hinweis">{release.hinweis}</p>}
                  </section>
                ))}
              </div>
            </>
          )}
          <figure>
            <img src={p.bild} alt={p.bildAlt} loading="lazy" />
            {p.bildHinweis && <figcaption>{p.bildHinweis}</figcaption>}
          </figure>
          <div class="tags">
            {p.stack.map((s) => <span class="tag">{s}</span>)}
          </div>
          {p.href && (
            <p>
              <a href={p.href} target="_blank" rel="noopener">
                {p.badge
                  ? <img class="badge" src={p.badge} alt={`Herunterladen im ${p.linkLabel}`} width="200" height="60" loading="lazy" />
                  : <>{p.linkLabel} ↗</>}
              </a>
              {p.secondaryHref && (
                <>
                  {' · '}
                  <a href={p.secondaryHref} target="_blank" rel="noopener">
                    {p.secondaryLinkLabel} ↗
                  </a>
                </>
              )}
              {p.tertiaryHref && (
                <>
                  {' · '}
                  <a href={p.tertiaryHref} target="_blank" rel="noopener">
                    {p.tertiaryLinkLabel} ↗
                  </a>
                </>
              )}
            </p>
          )}
        </article>
      ))}
    </section>
    <section id="kontakt">
      <h2>Kontakt</h2>
      <p>Du findest mich hier:</p>
      <div class="links">
        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
        <a href={links.github} target="_blank" rel="noopener">GitHub</a>
        <a href={links.codeberg} target="_blank" rel="noopener">Codeberg</a>
        <a href={links.email}>E-Mail</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .hero { padding-top: 3rem; display: flex; align-items: center; gap: 2rem; }
  .portrait { width: 180px; height: 180px; flex: 0 0 180px; object-fit: cover; object-position: center 30%; border-radius: 50%; border: 2px solid var(--border); }
  .subtitle { font-size: 1.05rem; margin-top: 0.4rem; }
  figcaption { color: var(--muted); font-size: 0.8rem; }
  h3 { margin-bottom: 0.35rem; }
  .project-heading { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-bottom: 0.35rem; }
  .project-heading h3 { margin: 0; min-width: 0; }
  .card .project-logo { display: block; width: 320px; max-width: 100%; height: auto; margin: 0; border-radius: 0; }
  .badge { display: block; height: auto; width: 200px; }
  h4 { margin: 0.75rem 0 0.25rem; }
  .releases { margin-bottom: 1rem; }
  .release + .release { border-top: 1px solid var(--border); margin-top: 1rem; padding-top: 1rem; }
  .release h5 { font-size: 1rem; margin-bottom: 0.25rem; }
  .release ul { padding-left: 1.25rem; }
  .release li { margin-bottom: 0.3rem; }
  .release-hinweis { margin-top: 0.75rem; }
  @media (max-width: 600px) {
    .hero { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
    .portrait { width: 140px; height: 140px; flex-basis: 140px; }
    .project-heading { align-items: flex-start; flex-direction: column; }
    .card .project-logo { width: 260px; }
  }
</style>
